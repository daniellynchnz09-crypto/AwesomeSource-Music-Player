<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background playback + its lock-screen/notification controls (Media3). No
         storage permission is declared - folder access goes through the Storage
         Access Framework (user picks a folder, we keep a persistable URI grant),
         not a broad READ_MEDIA_AUDIO/READ_EXTERNAL_STORAGE permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AwesomeSource">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AwesomeSource">
            <!-- Without an explicit softInputMode, edge-to-edge (enableEdgeToEdge in
                 MainActivity) leaves the system to guess how to lay out around the
                 keyboard, and on-device this let Gboard's suggestion-strip window
                 render pinned to the very top of the screen instead of just above the
                 keyboard - covering the top app bar's back button. adjustResize makes
                 the framework actually resize the content around the IME and report
                 real WindowInsets.ime insets, which fixed it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
